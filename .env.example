# Copy to .env for local overrides. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env
#
# Values here override config/runtime.env.

# COMFY_HOST=127.0.0.1        # do NOT set 0.0.0.0; use an SSH tunnel for remote access
# COMFY_PORT=8188
# COMFY_RESERVE_VRAM=1
# COMFY_PREVIEW_METHOD=none
# COMFY_DEFAULT_MODE=image

# Hugging Face token, only needed for gated repositories.
# HF_TOKEN=

# Optional: move the Hugging Face cache off the default ~/.cache location.
# HF_HOME=
