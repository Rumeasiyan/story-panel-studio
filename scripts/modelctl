#!/usr/bin/env python3
"""modelctl — manifest-driven model management for ai-video-gen.

Reads config/model-profiles.yaml, downloads pinned Hugging Face revisions into the
project-root models/ store, and never touches engine/ComfyUI/models.

    ./scripts/modelctl list
    ./scripts/modelctl show <profile>
    ./scripts/modelctl status
    ./scripts/modelctl set <profile>
    ./scripts/modelctl install <profile> [--yes] [--force] [--no-aria2]
    ./scripts/modelctl verify <profile> [--hash]
    ./scripts/modelctl disk
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROFILES_FILE = ROOT / "config" / "model-profiles.yaml"
ACTIVE_FILE = ROOT / ".active-model-profile"
STATE_FILE = ROOT / ".model-state.json"

# Approval thresholds from CLAUDE.md.
SINGLE_FILE_APPROVAL_BYTES = 5 * 1000**3
TOTAL_APPROVAL_BYTES = 10 * 1000**3

GB = 1000**3


def _load_dotenv() -> None:
    """Load a local .env (gitignored) without overriding the real environment.

    Only HF_TOKEN and HF_HOME matter here; the file is never logged or printed.
    """
    env_file = ROOT / ".env"
    if not env_file.exists():
        return
    for line in env_file.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if key and value:
            os.environ.setdefault(key, value)


_load_dotenv()


def _venv_python() -> Path:
    return ROOT / ".venv" / "bin" / "python"


def _reexec_in_venv() -> None:
    """Re-run inside the project venv so PyYAML / huggingface_hub are importable."""
    if os.environ.get("MODELCTL_REEXEC") == "1":
        return
    py = _venv_python()
    if py.exists() and Path(sys.executable).resolve() != py.resolve():
        os.environ["MODELCTL_REEXEC"] = "1"
        os.execv(str(py), [str(py), str(Path(__file__).resolve()), *sys.argv[1:]])


_reexec_in_venv()

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.exit(
        "PyYAML is not installed.\n"
        "Run: ./bootstrap.sh --core-only   (or: source .venv/bin/activate && "
        "pip install -r requirements-project.txt)"
    )


# --------------------------------------------------------------------- helpers

class Colour:
    enabled = sys.stdout.isatty()

    @classmethod
    def _wrap(cls, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if cls.enabled else text

    @classmethod
    def green(cls, t): return cls._wrap("0;32", t)

    @classmethod
    def red(cls, t): return cls._wrap("0;31", t)

    @classmethod
    def yellow(cls, t): return cls._wrap("0;33", t)

    @classmethod
    def bold(cls, t): return cls._wrap("1", t)


def human(n: int | None) -> str:
    if not n:
        return "?"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            return f"{n:.2f} {unit}" if unit != "B" else f"{n} B"
        n /= 1000.0
    return f"{n:.2f} TB"


def load_profiles() -> dict:
    if not PROFILES_FILE.exists():
        sys.exit(f"missing {PROFILES_FILE.relative_to(ROOT)}")
    data = yaml.safe_load(PROFILES_FILE.read_text()) or {}
    profiles = data.get("profiles") or {}
    if not profiles:
        sys.exit("config/model-profiles.yaml contains no profiles")
    return profiles


def get_profile(profiles: dict, name: str) -> dict:
    if name not in profiles:
        sys.exit(
            f"unknown profile '{name}'. Known profiles: {', '.join(sorted(profiles))}"
        )
    return profiles[name]


def artifact_path(art: dict) -> Path:
    dest = ROOT / art["destination"]
    local = art.get("local_filename") or Path(art["filename"]).name
    return dest / local


def artifact_state(art: dict) -> tuple[str, Path]:
    """Return ('ok' | 'size-mismatch' | 'missing', path)."""
    path = artifact_path(art)
    if not path.exists():
        return "missing", path
    expected = art.get("size_bytes")
    if expected and path.stat().st_size != expected:
        return "size-mismatch", path
    return "ok", path


def profile_state(profile: dict) -> str:
    states = [artifact_state(a)[0] for a in profile.get("artifacts", [])]
    if not states:
        return "empty"
    if all(s == "ok" for s in states):
        return "installed"
    if all(s == "missing" for s in states):
        return "not installed"
    return "incomplete"


def profile_bytes(profile: dict) -> int:
    return sum(a.get("size_bytes") or 0 for a in profile.get("artifacts", []))


def free_bytes(path: Path = ROOT) -> int:
    return shutil.disk_usage(path).free


def read_state() -> dict:
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def write_state(state: dict) -> None:
    STATE_FILE.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")


def active_profile() -> str | None:
    if ACTIVE_FILE.exists():
        value = ACTIVE_FILE.read_text().strip()
        return value or None
    return None


def confirm(question: str) -> bool:
    if not sys.stdin.isatty():
        print(f"{question} [non-interactive session: refusing; re-run with --yes]")
        return False
    try:
        return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(8 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def dir_bytes(path: Path) -> int:
    if not path.exists():
        return 0
    try:
        out = subprocess.run(
            ["du", "-sb", str(path)], capture_output=True, text=True, check=True
        ).stdout
        return int(out.split()[0])
    except Exception:
        return sum(f.stat().st_size for f in path.rglob("*") if f.is_file())


ARIA2_CONNECTIONS = 8


def artifact_url(art: dict) -> str:
    return (
        f"https://huggingface.co/{art['repository']}/resolve/"
        f"{art['revision']}/{art['filename']}"
    )


def aria2_download(art: dict, tmp: Path) -> None:
    """Fetch one artifact directly from the CDN with parallel ranges.

    Writes to `tmp` and resumes an existing partial file. Raises SystemExit on failure,
    leaving the partial file in place so a re-run continues where it stopped.
    """
    cmd = [
        "aria2c",
        artifact_url(art),
        "--dir", str(tmp.parent),
        "--out", tmp.name,
        f"--max-connection-per-server={ARIA2_CONNECTIONS}",
        f"--split={ARIA2_CONNECTIONS}",
        "--min-split-size=1M",
        "--continue=true",
        "--auto-file-renaming=false",
        "--allow-overwrite=true",
        "--max-tries=5",
        "--retry-wait=5",
        "--console-log-level=warn",
        "--summary-interval=10",
    ]
    token = os.environ.get("HF_TOKEN")
    if token:
        cmd.append(f"--header=Authorization: Bearer {token}")

    result = subprocess.run(cmd)
    if result.returncode != 0:
        sys.exit(
            f"aria2c failed for {art['id']} (exit {result.returncode}). "
            f"The partial file was kept at {tmp}; re-run install to resume."
        )


WORKFLOW_REMINDER = (
    "Note: a ComfyUI workflow stores the exact model filename in its loader node.\n"
    "      Switching profiles does not rewrite existing workflows."
)


# -------------------------------------------------------------------- commands

def cmd_list(args) -> int:
    profiles = load_profiles()
    active = active_profile()
    for name, profile in profiles.items():
        state = profile_state(profile)
        colour = {
            "installed": Colour.green,
            "not installed": Colour.yellow,
            "incomplete": Colour.red,
        }.get(state, Colour.yellow)
        marker = "*" if name == active else " "
        licences = sorted({a.get("licence", "?") for a in profile.get("artifacts", [])})
        print(f"{marker} {Colour.bold(name)}")
        print(f"    purpose  : {profile.get('description', '-')}")
        print(f"    state    : {colour(state)}")
        print(f"    download : {human(profile_bytes(profile))} "
              f"({len(profile.get('artifacts', []))} file(s))")
        print(f"    licence  : {', '.join(licences)}")
        print()
    print("* = active profile" if active else "no active profile set "
          "(./scripts/modelctl set <profile>)")
    return 0


def cmd_show(args) -> int:
    profiles = load_profiles()
    profile = get_profile(profiles, args.profile)
    print(Colour.bold(args.profile))
    print(f"  description     : {profile.get('description', '-')}")
    print(f"  engine          : {profile.get('engine', '-')}")
    print(f"  workflow family : {profile.get('workflow_family', '-')}")
    if profile.get("notes"):
        print(f"  notes           : {profile['notes'].strip()}")
    print(f"  total download  : {human(profile_bytes(profile))}")
    print()
    for art in profile.get("artifacts", []):
        state, path = artifact_state(art)
        colour = {"ok": Colour.green, "missing": Colour.yellow}.get(state, Colour.red)
        print(f"  - id          : {art['id']}")
        print(f"    repository  : {art['repository']}")
        print(f"    revision    : {art['revision']}")
        print(f"    filename    : {art['filename']}")
        print(f"    destination : {path.relative_to(ROOT)}")
        print(f"    size        : {human(art.get('size_bytes'))}")
        print(f"    sha256      : {art.get('sha256', '-')}")
        print(f"    licence     : {art.get('licence', '-')} "
              f"({art.get('licence_url', 'no url')})")
        if art.get("commercial_review_required"):
            print(f"    {Colour.yellow('commercial use requires licence review')}")
        print(f"    state       : {colour(state)}")
        print()
    return 0


def cmd_set(args) -> int:
    profiles = load_profiles()
    get_profile(profiles, args.profile)
    ACTIVE_FILE.write_text(args.profile + "\n")
    print(f"active profile set to {Colour.bold(args.profile)} "
          f"(local only, {ACTIVE_FILE.name} is gitignored)")
    print(WORKFLOW_REMINDER)
    return 0


def cmd_status(args) -> int:
    profiles = load_profiles()
    active = active_profile()
    print(f"active profile : {active or '(none)'}")
    print(f"project root   : {ROOT}")
    print(f"free space     : {human(free_bytes())}")
    print()
    missing_total = 0
    for name, profile in profiles.items():
        state = profile_state(profile)
        print(f"  {name:<16} {state}")
        for art in profile.get("artifacts", []):
            art_state, path = artifact_state(art)
            if art_state != "ok":
                missing_total += art.get("size_bytes") or 0
                print(f"      {Colour.yellow(art_state):<24} "
                      f"{path.relative_to(ROOT)} ({human(art.get('size_bytes'))})")
    print()
    print(f"models/ on disk : {human(dir_bytes(ROOT / 'models'))}")
    if missing_total:
        print(f"missing/invalid : {human(missing_total)} would need downloading")
    state = read_state()
    if state.get("installs"):
        print("\nrecorded installs:")
        for key, meta in sorted(state["installs"].items()):
            print(f"  {key}: rev {meta.get('revision', '?')[:12]} "
                  f"at {meta.get('installed_at', '?')}")
    return 0


def cmd_disk(args) -> int:
    rows = [
        ("models", ROOT / "models"),
        ("  checkpoints", ROOT / "models" / "checkpoints"),
        ("  diffusion_models", ROOT / "models" / "diffusion_models"),
        ("  text_encoders", ROOT / "models" / "text_encoders"),
        ("  vae", ROOT / "models" / "vae"),
        ("  loras", ROOT / "models" / "loras"),
        ("input", ROOT / "input"),
        ("output", ROOT / "output"),
        ("temp", ROOT / "temp"),
        ("cache", ROOT / "cache"),
        ("logs", ROOT / "logs"),
        ("user", ROOT / "user"),
        (".venv", ROOT / ".venv"),
        ("engine/ComfyUI", ROOT / "engine" / "ComfyUI"),
    ]
    for label, path in rows:
        print(f"  {label:<20} {human(dir_bytes(path)):>12}")
    print()
    print(f"  {'project total':<20} {human(dir_bytes(ROOT)):>12}")
    print(f"  {'free on volume':<20} {human(free_bytes()):>12}")
    return 0


def cmd_install(args) -> int:
    # The hf-xet transport stalled badly on this connection: it burned 2.26 GB of
    # network traffic to write 320 MB to disk, then wedged with concurrency pinned to
    # 1 and "connection struggling" in its logs. Plain HTTPS to the CDN is reliable
    # here and resumes properly. Override by exporting HF_HUB_DISABLE_XET=0.
    os.environ.setdefault("HF_HUB_DISABLE_XET", "1")

    try:
        from huggingface_hub import hf_hub_download
    except ImportError:
        sys.exit(
            "huggingface_hub is not installed.\n"
            "Run: source .venv/bin/activate && pip install -r requirements-project.txt"
        )

    profiles = load_profiles()
    profile = get_profile(profiles, args.profile)
    artifacts = profile.get("artifacts", [])
    use_aria2 = shutil.which("aria2c") is not None and not args.no_aria2

    plan, skip = [], []
    for art in artifacts:
        state, path = artifact_state(art)
        if state == "ok" and not args.force:
            skip.append((art, path))
        else:
            plan.append((art, path, state))

    print(Colour.bold(f"install plan: {args.profile}"))
    for art, path in skip:
        print(f"  {Colour.green('present')}  {path.relative_to(ROOT)} "
              f"({human(art.get('size_bytes'))})")
    for art, path, state in plan:
        print(f"  {Colour.yellow(state):<16} {art['repository']}@{art['revision'][:12]}")
        print(f"                   {art['filename']}")
        print(f"                -> {path.relative_to(ROOT)} "
              f"({human(art.get('size_bytes'))})")
        print(f"                   licence: {art.get('licence', '-')}")

    if not plan:
        print("\nnothing to download; all artifacts present and correctly sized.")
        return 0

    total = sum(a.get("size_bytes") or 0 for a, _, _ in plan)
    largest = max((a.get("size_bytes") or 0) for a, _, _ in plan)
    free = free_bytes()
    print()
    print(f"  total download : {human(total)}")
    print(f"  free space     : {human(free)}")

    # aria2 writes straight into models/. huggingface_hub stages the file in its cache
    # first, so that path needs headroom for two copies plus a margin.
    needed = int(total * (1.05 if use_aria2 else 2.1))
    if free < needed:
        detail = "" if use_aria2 else " (download cache + final copy)"
        sys.exit(
            f"\nrefusing to continue: need roughly {human(needed)} free"
            f"{detail}, only {human(free)} available."
        )

    needs_approval = (
        largest > SINGLE_FILE_APPROVAL_BYTES or total > TOTAL_APPROVAL_BYTES
    )
    if needs_approval and not args.yes:
        why = []
        if largest > SINGLE_FILE_APPROVAL_BYTES:
            why.append(f"a single file exceeds {human(SINGLE_FILE_APPROVAL_BYTES)}")
        if total > TOTAL_APPROVAL_BYTES:
            why.append(f"the set exceeds {human(TOTAL_APPROVAL_BYTES)}")
        print(f"\nApproval required: {'; '.join(why)}.")
        if not confirm("Proceed with the download?"):
            print("aborted; nothing downloaded.")
            return 1

    state_data = read_state()
    installs = state_data.setdefault("installs", {})

    if use_aria2:
        print(f"\ntransport: aria2c, {ARIA2_CONNECTIONS} connections per file")
    else:
        print("\ntransport: huggingface_hub (single stream)")

    for art, path, _ in plan:
        path.parent.mkdir(parents=True, exist_ok=True)
        print(f"\ndownloading {art['id']} ...")
        tmp = path.with_suffix(path.suffix + ".partial")

        if use_aria2:
            # Hugging Face throttles a single connection hard (measured ~0.7 MB/s here
            # against ~45 MB/s with 8 parallel ranges), so pull directly from the CDN
            # with aria2. Downloads straight to models/ — no second copy in the HF
            # cache — and --continue resumes an interrupted transfer.
            aria2_download(art, tmp)
            linked = True
        else:
            cached = hf_hub_download(
                repo_id=art["repository"],
                revision=art["revision"],
                filename=art["filename"],
                cache_dir=os.environ.get("HF_HOME"),
            )
            tmp.unlink(missing_ok=True)
            # Prefer a hard link to the cache blob: same filesystem means no second
            # copy on disk, and the data stays alive while any link references it.
            try:
                os.link(cached, tmp)
                linked = True
            except OSError:
                shutil.copyfile(cached, tmp)
                linked = False

        expected = art.get("size_bytes")
        actual = tmp.stat().st_size
        if expected and actual != expected:
            tmp.unlink(missing_ok=True)
            sys.exit(
                f"size mismatch for {art['id']}: expected {expected}, got {actual}. "
                "Nothing was written."
            )
        tmp.replace(path)
        installs[f"{args.profile}:{art['id']}"] = {
            "repository": art["repository"],
            "revision": art["revision"],
            "filename": art["filename"],
            "path": str(path.relative_to(ROOT)),
            "size_bytes": actual,
            "installed_at": subprocess.run(
                ["date", "-Iseconds"], capture_output=True, text=True
            ).stdout.strip(),
        }
        write_state(state_data)
        print(f"  {Colour.green('installed')} {path.relative_to(ROOT)}"
              f"{'' if linked else '  (copied)'}")

    if use_aria2:
        print("\nNothing was written to the Hugging Face cache; "
              "files went straight into models/.")

    print(f"\ndone. Verify with: ./scripts/modelctl verify {args.profile}")
    print(WORKFLOW_REMINDER)
    return 0


def cmd_verify(args) -> int:
    profiles = load_profiles()
    profile = get_profile(profiles, args.profile)
    failures = 0
    for art in profile.get("artifacts", []):
        state, path = artifact_state(art)
        label = f"{art['id']:<22}"
        if state == "missing":
            print(f"  {Colour.red('MISSING')}  {label} {path.relative_to(ROOT)}")
            failures += 1
            continue
        if state == "size-mismatch":
            print(f"  {Colour.red('BAD SIZE')} {label} "
                  f"expected {art['size_bytes']}, got {path.stat().st_size}")
            failures += 1
            continue
        if args.hash and art.get("sha256"):
            print(f"  hashing   {label} ({human(art.get('size_bytes'))}) ...",
                  end="", flush=True)
            digest = sha256_file(path)
            if digest != art["sha256"]:
                print(f"\r  {Colour.red('BAD HASH')} {label} {digest}")
                failures += 1
                continue
            print(f"\r  {Colour.green('OK')}       {label} size + sha256")
        else:
            print(f"  {Colour.green('OK')}       {label} size matches "
                  f"({human(art.get('size_bytes'))})")
    if not args.hash:
        print("\n(size check only; run with --hash for full SHA-256 verification)")
    return 1 if failures else 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="modelctl", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("list", help="list profiles").set_defaults(func=cmd_list)
    sub.add_parser("status", help="installed/missing overview").set_defaults(func=cmd_status)
    sub.add_parser("disk", help="disk usage breakdown").set_defaults(func=cmd_disk)

    p = sub.add_parser("show", help="show a profile in detail")
    p.add_argument("profile")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("set", help="select the active profile")
    p.add_argument("profile")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("install", help="download a profile's artifacts")
    p.add_argument("profile")
    p.add_argument("--yes", action="store_true",
                   help="skip the interactive approval prompt for large downloads")
    p.add_argument("--force", action="store_true",
                   help="re-download artifacts that are already present and valid")
    p.add_argument("--no-aria2", action="store_true",
                   help="use huggingface_hub single-stream download instead of aria2c")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("verify", help="verify installed artifacts")
    p.add_argument("profile")
    p.add_argument("--hash", action="store_true",
                   help="also verify SHA-256 (slow; reads every byte)")
    p.set_defaults(func=cmd_verify)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
