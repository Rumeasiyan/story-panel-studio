logs/*.txt

# Generated media
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
# Exception: the locked voice anchors. OmniVoice's auto and design modes invent a new
# speaker on every call, so a01/a03/m02/m03 cannot be regenerated by any recipe — the
# file IS the voice. Ignoring them meant a fresh clone produced a repo that could not
# reproduce its own locked narration. 4.2 MB total, which is what makes the exception
# affordable; bulk renders stay ignored.
!assets/voices/locked/*.wav
*.flac
*.mp3
*.aac

# Large source media and transient images
*.psd
*.xcf
*.blend
*.exr

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Model install state (local)
.model-state.json
logs/*.md

# Local backups made by bootstrap/update scripts
*.bak
*.bak.*

# Local web UI runtime state (database, uploads, thumbnails)
service/data/
cache/object-info.json
.venv-parler/
.venv-trainer/
characters/_training/
characters/*/images/
