# Non-secret runtime defaults for story-panel-studio. Committed.
# Override locally with a gitignored .env (see .env.example).

COMFY_HOST=127.0.0.1
COMFY_PORT=8188

# GiB of VRAM kept free for Hyprland and the desktop.
COMFY_RESERVE_VRAM=1

# none | auto | latent2rgb | taesd
COMFY_PREVIEW_METHOD=none

# image | lowvram | wan
COMFY_DEFAULT_MODE=image

# Local web UI (service/). Sanity bounds only — not tuned to any particular GPU.
# Raise them if you run this on a bigger card.
#
# The UI has NO authentication: anyone who can reach this port can generate,
# browse, download and delete every generation. So the committed default is
# loopback, and widening it is a local decision made in .env, never here.
#
#   127.0.0.1   this machine only. The safe default.
#   <tailnet IP> reachable from your own devices over Tailscale. What this
#               workstation uses; set it in .env, not in this file.
#   0.0.0.0     every interface, including café wifi and any LAN. Don't.
#
# ComfyUI is unaffected either way: it always stays on 127.0.0.1, because
# /prompt executes arbitrary node graphs.
UI_HOST=127.0.0.1
UI_PORT=8189
UI_MAX_DIM=4096
UI_MAX_FRAMES=1001
