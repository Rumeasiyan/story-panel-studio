# Non-secret runtime defaults for story-panel-studio. Committed.
# Override locally with a gitignored .env (see .env.example).

COMFY_HOST=127.0.0.1
COMFY_PORT=8188

# GiB of VRAM kept free for Hyprland and the desktop.
COMFY_RESERVE_VRAM=1

# none | auto | latent2rgb | taesd
COMFY_PREVIEW_METHOD=none

# image | lowvram | wan
COMFY_DEFAULT_MODE=image

# Local web UI (service/). Sanity bounds only — not tuned to any particular GPU.
# Raise them if you run this on a bigger card.
# 127.0.0.1 keeps the UI on this machine only.
# 0.0.0.0 makes it reachable from any device on the network. The UI has NO
# authentication, so only do this on a network you trust. ComfyUI is unaffected:
# it always stays on 127.0.0.1.
UI_HOST=0.0.0.0
UI_PORT=8189
UI_MAX_DIM=4096
UI_MAX_FRAMES=1001
